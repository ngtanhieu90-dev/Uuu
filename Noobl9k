local function ToggleFakeGhost(enabled)
    Config.FakeGhost = enabled
    QGBtn.BackgroundColor3 = enabled and Color3.fromRGB(35, 165, 75) or Color3.fromRGB(190, 40, 40)
    QGBtn.Text = enabled and "BẬT" or "TẮT"

    local char = LocalPlayer.Character
    if char then
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
                obj.LocalTransparencyModifier = enabled and 0.65 or 0
            elseif obj:IsA("Decal") then
                obj.Transparency = enabled and 0.65 or 0
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.HipHeight = enabled and 1.6 or 0
        end
    end
end

